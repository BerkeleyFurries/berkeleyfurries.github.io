---
/*
    This is the merch page :3
*/

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Merch & Club Dues"
    description="Check out Furries at Berkeley official merch and club dues perks! :3"
>
    <!-- Header section -->
    <section class="merch-header-section text-center">
        <div class="container">
            <h1 class="page-title">Club Dues & Merch</h1>
            <p class="tagline">
                Support Furries at Berkeley and get pawesome gear! :3
            </p>
        </div>
    </section>

    <!-- Main Content Section -->
    <section class="content-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-10">
                    <!-- Dues Graphic Card -->
                    <div class="merch-card mb-5">
                        <div class="card-header-custom">
                            <h2>Club Dues Tier Structure</h2>
                            <p class="mb-0 text-muted">
                                Perks included per semester of membership dues
                                ($10)!
                            </p>
                        </div>
                        <div class="card-body-custom text-center">
                            <img
                                src="/img/dues.png"
                                class="dues-img img-fluid"
                                loading="eager"
                            />
                        </div>
                    </div>

                    <!-- Dues Breakdown Summary Section -->
                    <div class="merch-card mb-5">
                        <div class="card-header-custom">
                            <h2>Dues Perks Breakdown</h2>
                            <p class="mb-0 text-muted">
                                What you get each semester as a member!
                            </p>
                        </div>
                        <div class="card-body-custom">
                            <div class="row g-4">
                                <div class="col-md-6 col-lg-3">
                                    <div class="tier-box">
                                        <div class="tier-badge">Sem 1</div>
                                        <h4>Stickers</h4>
                                        <p class="price-tag">
                                            Outside Cost: $2 for 1 / $3 for 3
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="tier-box">
                                        <div class="tier-badge">Sem 2</div>
                                        <h4>Certified Golden Bear Tags</h4>
                                        <p class="price-tag">
                                            Outside Cost: Exclusive
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="tier-box">
                                        <div class="tier-badge">Sem 3</div>
                                        <h4>Lanyard</h4>
                                        <p class="price-tag">
                                            Outside Cost: Exclusive ($5 for
                                            extra)
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="tier-box">
                                        <div class="tier-badge">Sem 4</div>
                                        <h4>Club Shirt</h4>
                                        <p class="price-tag">
                                            Outside Cost: $25
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="tier-box">
                                        <div class="tier-badge">Sem 5</div>
                                        <h4>Exclusive Pin</h4>
                                        <p class="price-tag">
                                            Outside Cost: $15
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="tier-box">
                                        <div class="tier-badge">Sem 6</div>
                                        <h4>Exclusive Pin</h4>
                                        <p class="price-tag">
                                            Outside Cost: $15
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="tier-box">
                                        <div class="tier-badge">Sem 7</div>
                                        <h4>Exclusive Pin</h4>
                                        <p class="price-tag">
                                            Outside Cost: $15
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="tier-box">
                                        <div class="tier-badge">Sem 8</div>
                                        <h4>Senior Perk</h4>
                                        <p class="price-tag">TBA :3</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- How to Pay Dues / Get Merch Card -->
                    <div class="merch-card">
                        <div class="card-header-custom">
                            <h2>How to Get Merch & Pay Dues</h2>
                        </div>
                        <div class="card-body-custom">
                            <p class="lead-text">
                                Want to pay your semester dues or pick up
                                individual merch items?
                            </p>
                            <ul class="styled-list">
                                <li>
                                    <strong>In-Person Tabling:</strong> Come visit
                                    us during tabling or at meetings!
                                </li>
                                <li>
                                    <strong>Club Discord:</strong> Check our Discord
                                    server announcements or contact execs for payment
                                    details.
                                </li>
                            </ul>
                            <div class="mt-4">
                                <a
                                    href="/contact"
                                    class="btn btn-primary custom-btn"
                                    >Contact Us</a
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .merch-header-section {
        background: linear-gradient(
            135deg,
            var(--blue) 0%,
            var(--dark-blue) 100%
        );
        color: var(--white);
        padding: 3rem 1rem 2.5rem;
    }

    .page-title {
        font-size: 2.75rem;
        font-weight: 800;
        color: var(--text-title);
        margin-bottom: 0.5rem;
    }

    .tagline {
        font-size: 1.2rem;
        color: var(--text-subtitle);
        font-weight: 500;
        margin-bottom: 0;
    }

    .content-section {
        background-color: var(--light-gray);
        min-height: 60vh;
    }

    .merch-card {
        background: var(--white);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: 0 4px 16px var(--shadow-subtle);
        transition: all 0.2s ease;
    }

    .merch-card:hover {
        border-color: var(--border-subtle-hover);
        box-shadow: 0 6px 20px var(--shadow-subtle-hover);
    }

    .card-header-custom {
        background: rgba(0, 38, 118, 0.04);
        border-bottom: 1px solid var(--card-border);
        padding: 1.25rem 1.75rem;
    }

    .card-header-custom h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--blue);
        margin-bottom: 0.25rem;
    }

    .card-body-custom {
        padding: 1.75rem;
    }

    .dues-img {
        border-radius: 8px;
        max-width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
    }

    .tier-box {
        background: var(--light-gray);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-sm);
        padding: 1.25rem 1rem;
        height: 100%;
        text-align: center;
    }

    .tier-badge {
        display: inline-block;
        background: var(--blue);
        color: var(--text-title);
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        margin-bottom: 0.75rem;
    }

    .tier-box h4 {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.5rem;
    }

    .price-tag {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0;
    }

    .lead-text {
        font-size: 1.1rem;
        color: var(--text-main);
        margin-bottom: 1rem;
    }

    .styled-list {
        padding-left: 1.25rem;
        color: var(--text-muted);
    }

    .styled-list li {
        margin-bottom: 0.5rem;
    }

    .custom-btn {
        background-color: var(--blue);
        border-color: var(--blue);
        color: var(--white);
        font-weight: 600;
        padding: 0.6rem 1.4rem;
        border-radius: var(--radius-sm);
        transition: all 0.2s ease;
    }

    .custom-btn:hover {
        background-color: var(--dark-blue);
        border-color: var(--dark-blue);
        color: var(--gold);
        transform: translateY(-2px);
    }
</style>
