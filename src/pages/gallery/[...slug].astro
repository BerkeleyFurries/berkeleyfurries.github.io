---
/*
    Dynamic catch-all event route :3
    Route: /gallery/[...slug]
    Handles both:
    - Main event page: /gallery/sammies
    - Photo sub-routes: /gallery/sammies/photo/1
*/

import BaseLayout from "../../layouts/BaseLayout.astro";
import { readdir, readFile } from "node:fs/promises";
import { join } from "node:path";
import { ensureThumbnail } from "../../utils/thumbnail";

interface PhotoMeta {
    photographer?: string;
    suiters?: string[];
    description?: string;
}

interface GalleryEvent {
    id: string;
    name: string;
    slug: string;
    date: string;
    dateEnd?: string;
    description: string;
    cover: string;
    coverUrl: string;
    coverThumbUrl: string;
    photoMeta: Record<string, PhotoMeta>;
    photos: string[];
    photoThumbs: Record<string, string>;
}

export async function getStaticPaths() {
    const IMAGE_EXTS = new Set([
        ".jpg",
        ".jpeg",
        ".png",
        ".webp",
        ".gif",
        ".avif",
    ]);
    const galleryRoot = join(process.cwd(), "public", "gallery");
    const paths: {
        params: { slug: string };
        props: { event: GalleryEvent; initialPhotoIndex: number | null };
    }[] = [];

    try {
        const folders = await readdir(galleryRoot, { withFileTypes: true });
        for (const folder of folders.filter((d) => d.isDirectory())) {
            const folderPath = join(galleryRoot, folder.name);
            try {
                const jsonRaw = await readFile(
                    join(folderPath, "event.json"),
                    "utf-8",
                );
                const json = JSON.parse(jsonRaw);
                const allFiles = await readdir(folderPath);
                const photos = allFiles
                    .filter((f) => {
                        const ext = "." + f.split(".").pop()!.toLowerCase();
                        return IMAGE_EXTS.has(ext);
                    })
                    .sort((a, b) =>
                        a.localeCompare(b, undefined, {
                            numeric: true,
                            sensitivity: "base",
                        }),
                    );
                const slug = folder.name;
                const coverFilename = json.cover ?? photos[0] ?? "";
                const coverUrl = `/gallery/${folder.name}/${coverFilename}`;
                const coverThumbUrl = await ensureThumbnail(
                    folder.name,
                    coverFilename,
                );

                const photoThumbs: Record<string, string> = {};
                for (const photo of photos) {
                    photoThumbs[photo] = await ensureThumbnail(
                        folder.name,
                        photo,
                    );
                }

                const eventData: GalleryEvent = {
                    id: folder.name,
                    name: json.name ?? "Untitled Event",
                    slug,
                    date: json.date ?? "",
                    dateEnd: json.dateEnd ?? "",
                    description: json.description ?? "",
                    cover: coverFilename,
                    coverUrl,
                    coverThumbUrl,
                    photoMeta: json.photoMeta ?? {},
                    photos,
                    photoThumbs,
                };

                // 1. Main event page route: /gallery/sammies
                paths.push({
                    params: { slug },
                    props: { event: eventData, initialPhotoIndex: null },
                });

                // 2. Photo sub-routes: /gallery/sammies/photo/1, /2, etc.
                photos.forEach((_, idx) => {
                    paths.push({
                        params: { slug: `${slug}/photo/${idx + 1}` },
                        props: { event: eventData, initialPhotoIndex: idx },
                    });
                });
            } catch (err) {
                console.error(
                    `Error loading gallery event folder "${folder.name}":`,
                    err,
                );
            }
        }
    } catch (err) {
        console.error("Error reading gallery directory:", err);
    }

    return paths;
}

const { event, initialPhotoIndex } = Astro.props as {
    event: GalleryEvent;
    initialPhotoIndex: number | null;
};

function formatDate(date: string, dateEnd?: string): string {
    if (!date) return "";
    const fmt = (d: string) =>
        new Date(d + "T12:00:00").toLocaleDateString("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric",
        });
    return dateEnd ? `${fmt(date)} – ${fmt(dateEnd)}` : fmt(date);
}

const basePath = `/gallery/${event.id}/`;

const isPhotoRoute =
    typeof initialPhotoIndex === "number" &&
    initialPhotoIndex >= 0 &&
    initialPhotoIndex < event.photos.length;
const currentPhotoFile = isPhotoRoute ? event.photos[initialPhotoIndex!] : null;
const photoMeta = currentPhotoFile
    ? (event.photoMeta[currentPhotoFile] ?? {})
    : {};

const pageTitle = isPhotoRoute
    ? `${event.name} — Photo ${initialPhotoIndex! + 1}`
    : `${event.name} Gallery`;

const pageDescription = isPhotoRoute
    ? photoMeta.description ||
      (photoMeta.suiters?.length
          ? `Suiters: ${photoMeta.suiters.join(", ")}`
          : `Photo ${initialPhotoIndex! + 1} from ${event.name}`)
    : event.description || `Photos from ${event.name}`;

const pageOgImage = isPhotoRoute
    ? event.photoThumbs[currentPhotoFile!] || `${basePath}${currentPhotoFile}`
    : event.coverThumbUrl || event.coverUrl;
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    ogImage={pageOgImage}
>
    <!-- Event Header -->
    <section class="hero-banner">
        <div class="hero-banner-bg-wrap">
            <img
                src={event.coverUrl}
                alt=""
                class="hero-banner-bg"
                loading="eager"
                decoding="async"
                onerror="this.style.display='none';"
            />
            <div class="hero-banner-overlay"></div>
        </div>
        <div class="container hero-banner-content">
            <a href="/gallery" class="back-link">← Back to Gallery</a>
            <h1 class="event-name">{event.name}</h1>
            {
                event.date && (
                    <p class="event-date">
                        📅 {formatDate(event.date, event.dateEnd)}
                    </p>
                )
            }
            {
                event.description && (
                    <p class="event-description">{event.description}</p>
                )
            }
            <p class="event-photo-count">
                {event.photos.length} photo{
                    event.photos.length !== 1 ? "s" : ""
                }
            </p>
        </div>
    </section>

    <!-- Photo Grid -->
    <section class="photo-section">
        <div class="container">
            {
                event.photos.length === 0 ? (
                    <div class="empty-state">
                        <span>🐾</span>
                        <p>No photos in this event yet.</p>
                    </div>
                ) : (
                    <div class="photo-grid" id="photo-grid">
                        {event.photos.map((filename, idx) => {
                            const meta = event.photoMeta[filename] ?? {};
                            const url = basePath + filename;
                            const thumbUrl =
                                event.photoThumbs?.[filename] || url;
                            return (
                                <button
                                    class="photo-thumb-btn"
                                    data-index={idx}
                                    aria-label={`View photo ${idx + 1}${meta.suiters?.length ? ` — ${meta.suiters.join(", ")}` : ""}`}
                                >
                                    <div class="photo-thumb-wrap">
                                        <img
                                            src={thumbUrl}
                                            alt={filename}
                                            class="photo-thumb"
                                            loading="lazy"
                                            decoding="async"
                                            onerror={`if (this.src !== '${url}') { this.src='${url}'; } else { this.closest('.photo-thumb-wrap').classList.add('img-error'); }`}
                                        />
                                        <div class="photo-thumb-overlay">
                                            {meta.description ? (
                                                <span class="thumb-description">
                                                    {meta.description}
                                                </span>
                                            ) : null}
                                            {meta.suiters?.length ? (
                                                <span class="thumb-suiters">
                                                    🐾 {meta.suiters.join(", ")}
                                                </span>
                                            ) : null}
                                            {meta.photographer ? (
                                                <span class="thumb-photographer">
                                                    📷 {meta.photographer}
                                                </span>
                                            ) : null}
                                        </div>
                                    </div>
                                </button>
                            );
                        })}
                    </div>
                )
            }
        </div>
    </section>

    <!-- Lightbox -->
    <div
        id="gallery-lightbox"
        class="lightbox"
        role="dialog"
        aria-modal="true"
        aria-label="Photo viewer"
        hidden={!isPhotoRoute}
    >
        <div class="lightbox-backdrop" id="lightbox-backdrop"></div>

        <!-- Close button — fixed to viewport top-right, never moves -->
        <button
            class="lightbox-close"
            id="lightbox-close"
            aria-label="Close gallery">✕</button
        >

        <div class="lightbox-inner">
            <button
                class="lightbox-nav lightbox-prev"
                id="lightbox-prev"
                aria-label="Previous photo"
                style={event.photos.length > 1 ? "" : "display: none;"}
                >‹</button
            >
            <button
                class="lightbox-nav lightbox-next"
                id="lightbox-next"
                aria-label="Next photo"
                style={event.photos.length > 1 ? "" : "display: none;"}
                >›</button
            >
            <div class="lightbox-img-wrap">
                <img
                    id="lightbox-img"
                    src={isPhotoRoute ? `${basePath}${currentPhotoFile}` : ""}
                    alt={isPhotoRoute ? currentPhotoFile || "" : ""}
                    class={isPhotoRoute
                        ? "lightbox-img loaded"
                        : "lightbox-img"}
                />
                <div
                    class="lightbox-spinner"
                    id="lightbox-spinner"
                    hidden={isPhotoRoute}
                >
                </div>
            </div>
            <div class="lightbox-caption">
                <div class="lightbox-meta">
                    <span class="lightbox-counter" id="lightbox-counter">
                        {
                            isPhotoRoute
                                ? `${initialPhotoIndex! + 1} / ${event.photos.length}`
                                : ""
                        }
                    </span>
                    <span
                        class="lightbox-photographer"
                        id="lightbox-photographer"
                        style={photoMeta.photographer ? "" : "display: none;"}
                        >{
                            photoMeta.photographer
                                ? `📷 ${photoMeta.photographer}`
                                : ""
                        }</span
                    >
                    <span
                        class="lightbox-suiters"
                        id="lightbox-suiters"
                        style={photoMeta.suiters?.length
                            ? ""
                            : "display: none;"}
                        >{
                            photoMeta.suiters?.length
                                ? `🐾 ${photoMeta.suiters.join(", ")}`
                                : ""
                        }</span
                    >
                </div>
                <p
                    class="lightbox-description"
                    id="lightbox-description"
                    style={photoMeta.description ? "" : "display: none;"}
                >
                    {photoMeta.description || ""}
                </p>
            </div>
        </div>
    </div>

    {
        isPhotoRoute && (
            <script is:inline>document.body.style.overflow = "hidden";</script>
        )
    }

    <!-- Embed photo data for JS -->
    <div
        id="event-photos-data-container"
        data-photos-data={JSON.stringify({
            basePath,
            slug: event.slug,
            photos: event.photos,
            photoMeta: event.photoMeta,
            initialPhotoIndex: initialPhotoIndex ?? null,
        })}
        hidden
    >
    </div>
</BaseLayout>

<script>
    interface PhotoMeta {
        photographer?: string;
        suiters?: string[];
        description?: string;
    }
    interface EventPhotosData {
        basePath: string;
        slug: string;
        photos: string[];
        photoMeta: Record<string, PhotoMeta>;
        initialPhotoIndex?: number | null;
    }

    let cleanupSlugGallery: (() => void) | null = null;

    function initSlugGallery() {
        if (cleanupSlugGallery) {
            cleanupSlugGallery();
            cleanupSlugGallery = null;
        }

        const container = document.getElementById(
            "event-photos-data-container",
        );
        if (!container) return;

        const raw = container.dataset.photosData ?? "{}";
        const data: EventPhotosData = JSON.parse(raw);
        const { basePath, slug, photos, photoMeta, initialPhotoIndex } = data;
        if (!photos || photos.length === 0) return;

        function preloadNeighbors(
            index: number,
            photoList: string[],
            folderPath: string,
        ) {
            const total = photoList.length;
            if (total <= 1) return;
            const count = 1;
            for (let i = 1; i <= count; i++) {
                const nextUrl = folderPath + photoList[(index + i) % total];
                const prevUrl =
                    folderPath + photoList[(index - i + total) % total];
                const nextImg = new Image();
                nextImg.src = nextUrl;
                const prevImg = new Image();
                prevImg.src = prevUrl;
            }
        }

        let currentIndex = 0;

        const lightbox = document.getElementById("gallery-lightbox")!;
        if (!lightbox) return;

        const backdrop = document.getElementById("lightbox-backdrop")!;
        const closeBtn = document.getElementById("lightbox-close")!;
        const prevBtn = document.getElementById("lightbox-prev")!;
        const nextBtn = document.getElementById("lightbox-next")!;
        const imgEl = document.getElementById(
            "lightbox-img",
        ) as HTMLImageElement;
        const spinner = document.getElementById("lightbox-spinner")!;
        const counterEl = document.getElementById("lightbox-counter")!;
        const photographerEl = document.getElementById(
            "lightbox-photographer",
        )!;
        const suitersEl = document.getElementById("lightbox-suiters")!;
        const descriptionEl = document.getElementById("lightbox-description")!;
        const gridEl = document.getElementById("photo-grid");

        function getPhotoIndexFromPath(): number | null {
            const pathName = decodeURIComponent(window.location.pathname);
            const match = pathName.match(/\/photo\/(\d+)\/?$/i);
            if (match) {
                const pNum = parseInt(match[1], 10);
                if (pNum >= 1 && pNum <= photos.length) {
                    return pNum - 1;
                }
            }
            return null;
        }

        function openLightbox(index: number, updateUrl = true) {
            currentIndex = index;
            showPhoto(index, updateUrl);
            lightbox.hidden = false;
            document.body.style.overflow = "hidden";
            setTimeout(() => closeBtn.focus(), 50);
        }

        function closeLightbox(updateUrl = true) {
            lightbox.hidden = true;
            document.body.style.overflow = "";
            imgEl.src = "";
            if (updateUrl) {
                const targetPath = `/gallery/${slug}`;
                if (
                    window.location.pathname !== targetPath &&
                    window.location.pathname !== targetPath + "/"
                ) {
                    history.replaceState(history.state, "", targetPath);
                }
            }
        }

        function showPhoto(index: number, updateUrl = true) {
            const total = photos.length;
            index = ((index % total) + total) % total;
            currentIndex = index;

            if (updateUrl) {
                const targetPath = `/gallery/${slug}/photo/${index + 1}`;
                if (
                    window.location.pathname !== targetPath &&
                    window.location.pathname !== targetPath + "/"
                ) {
                    history.replaceState(
                        { ...history.state, lightbox: true, index },
                        "",
                        targetPath,
                    );
                }
            }

            const filename = photos[index];
            const url = basePath + filename;
            const meta = photoMeta[filename] ?? {};

            imgEl.alt = filename;

            imgEl.classList.remove("loaded");
            spinner.hidden = false;
            imgEl.src = url;
            imgEl.onload = () => {
                imgEl.classList.add("loaded");
                spinner.hidden = true;
            };
            imgEl.onerror = () => {
                spinner.hidden = true;
            };
            if (imgEl.complete && imgEl.naturalWidth !== 0) {
                imgEl.classList.add("loaded");
                spinner.hidden = true;
            }

            preloadNeighbors(index, photos, basePath);

            counterEl.textContent = `${index + 1} / ${total}`;
            if (meta.photographer) {
                photographerEl.textContent = `📷 ${meta.photographer}`;
                photographerEl.style.display = "";
            } else {
                photographerEl.textContent = "";
                photographerEl.style.display = "none";
            }

            if (meta.suiters?.length) {
                suitersEl.textContent = `🐾 ${meta.suiters.join(", ")}`;
                suitersEl.style.display = "";
            } else {
                suitersEl.textContent = "";
                suitersEl.style.display = "none";
            }

            if (meta.description) {
                descriptionEl.textContent = meta.description;
                descriptionEl.style.display = "";
            } else {
                descriptionEl.textContent = "";
                descriptionEl.style.display = "none";
            }

            prevBtn.style.display = total > 1 ? "" : "none";
            nextBtn.style.display = total > 1 ? "" : "none";
        }

        function navigate(dir: 1 | -1) {
            showPhoto(currentIndex + dir);
        }

        const onGridClick = (e: MouseEvent) => {
            const btn = (e.target as Element).closest(
                "[data-index]",
            ) as HTMLElement | null;
            if (btn) openLightbox(Number(btn.dataset.index));
        };

        const onCloseClick = () => closeLightbox();
        const onBackdropClick = () => closeLightbox();
        const onPrevClick = () => navigate(-1);
        const onNextClick = () => navigate(1);

        const onKeyDown = (e: KeyboardEvent) => {
            if (lightbox.hidden) return;
            if (e.key === "Escape") closeLightbox();
            if (e.key === "ArrowLeft") navigate(-1);
            if (e.key === "ArrowRight") navigate(1);
        };

        const onImgClick = (e: MouseEvent) => {
            e.stopPropagation();
            const rect = imgEl.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            if (clickX < rect.width * 0.3) {
                navigate(-1);
            } else {
                navigate(1);
            }
        };

        let touchStartX = 0;
        let touchStartY = 0;
        const onTouchStart = (e: TouchEvent) => {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
        };
        const onTouchEnd = (e: TouchEvent) => {
            const dx = e.changedTouches[0].clientX - touchStartX;
            const dy = e.changedTouches[0].clientY - touchStartY;
            if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
                navigate(dx < 0 ? 1 : -1);
            }
        };

        function checkPathAndOpen() {
            const pathIdx = getPhotoIndexFromPath();
            if (pathIdx !== null) {
                openLightbox(pathIdx, false);
            } else if (!lightbox.hidden) {
                closeLightbox(false);
            }
        }

        gridEl?.addEventListener("click", onGridClick);
        closeBtn.addEventListener("click", onCloseClick);
        backdrop.addEventListener("click", onBackdropClick);
        prevBtn.addEventListener("click", onPrevClick);
        nextBtn.addEventListener("click", onNextClick);
        document.addEventListener("keydown", onKeyDown);
        imgEl.addEventListener("click", onImgClick);
        lightbox.addEventListener("touchstart", onTouchStart, {
            passive: true,
        });
        lightbox.addEventListener("touchend", onTouchEnd);
        window.addEventListener("popstate", checkPathAndOpen);

        // Check on initial load
        const initIdx =
            typeof initialPhotoIndex === "number" && initialPhotoIndex >= 0
                ? initialPhotoIndex
                : getPhotoIndexFromPath();
        if (initIdx !== null && initIdx >= 0 && initIdx < photos.length) {
            openLightbox(initIdx, false);
        }

        cleanupSlugGallery = () => {
            gridEl?.removeEventListener("click", onGridClick);
            closeBtn.removeEventListener("click", onCloseClick);
            backdrop.removeEventListener("click", onBackdropClick);
            prevBtn.removeEventListener("click", onPrevClick);
            nextBtn.removeEventListener("click", onNextClick);
            document.removeEventListener("keydown", onKeyDown);
            imgEl.removeEventListener("click", onImgClick);
            lightbox.removeEventListener("touchstart", onTouchStart);
            lightbox.removeEventListener("touchend", onTouchEnd);
            window.removeEventListener("popstate", checkPathAndOpen);
        };
    }

    document.addEventListener("astro:page-load", initSlugGallery);
    document.addEventListener("astro:before-swap", () => {
        if (cleanupSlugGallery) {
            cleanupSlugGallery();
            cleanupSlugGallery = null;
        }
    });
</script>

<style>
    /* Unified Hero Banner */
    .hero-banner {
        margin-top: 0;
        position: relative;
        min-height: 320px;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        background: var(--dark-blue);
        border-bottom: 3px solid var(--gold);
    }
    .hero-banner-bg-wrap {
        position: absolute;
        inset: 0;
    }
    .hero-banner-bg {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        opacity: 0.5;
    }
    .hero-banner-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 10, 30, 0.92) 0%,
            rgba(0, 10, 30, 0.35) 100%
        );
    }
    .hero-banner-content {
        position: relative;
        z-index: 1;
        padding-top: 5rem;
        padding-bottom: 2.5rem;
        width: 100%;
    }
    .back-link {
        display: inline-block;
        color: var(--gold);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        margin-bottom: 1rem;
        opacity: 0.85;
        transition: opacity 0.2s;
    }
    .back-link:hover {
        opacity: 1;
    }
    .event-name {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--text-title);
        margin-bottom: 0.4rem;
        line-height: 1.2;
    }
    .event-date {
        color: var(--gold);
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.6rem;
    }
    .event-description {
        color: var(--text-subtitle);
        font-size: 1rem;
        line-height: 1.6;
        max-width: 650px;
        margin-bottom: 0.75rem;
        white-space: pre-line;
    }
    .event-photo-count {
        color: rgba(255, 255, 255, 0.45);
        font-size: 0.85rem;
        margin: 0;
    }

    /* Photo Grid */
    .photo-section {
        padding: 3rem 0 4rem;
    }
    .photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.75rem;
    }
    .photo-thumb-btn {
        all: unset;
        cursor: pointer;
        display: block;
    }
    .photo-thumb-wrap {
        position: relative;
        aspect-ratio: 1;
        background: var(--light-gray);
        border-radius: var(--radius-sm);
        overflow: hidden;
        border: 1px solid var(--card-border);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }
    .photo-thumb-wrap.img-error::after {
        content: "🐾";
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }
    .photo-thumb-btn:hover .photo-thumb-wrap {
        transform: scale(1.02);
        box-shadow: 0 8px 24px rgba(0, 38, 118, 0.12);
    }
    .photo-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 0.3s ease;
        display: block;
    }
    .photo-thumb-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 10, 30, 0);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0.5rem;
        gap: 0.2rem;
        transition: background 0.25s ease;
    }
    .photo-thumb-btn:hover .photo-thumb-overlay {
        background: rgba(0, 10, 30, 0.6);
    }
    .thumb-description,
    .thumb-suiters,
    .thumb-photographer {
        font-size: 0.72rem;
        color: white;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 4px;
        padding: 0.15rem 0.4rem;
        opacity: 0;
        transform: translateY(4px);
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .thumb-description {
        font-style: italic;
    }
    .photo-thumb-btn:hover .thumb-description,
    .photo-thumb-btn:hover .thumb-suiters,
    .photo-thumb-btn:hover .thumb-photographer {
        opacity: 1;
        transform: translateY(0);
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 5rem 1rem;
        color: var(--text-muted);
        font-size: 1.1rem;
    }
    .empty-state span {
        display: block;
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    /* Lightbox */
    .lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .lightbox[hidden] {
        display: none;
    }
    .lightbox-backdrop {
        position: absolute;
