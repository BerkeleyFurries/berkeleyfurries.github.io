---
/*
    This is the events page :3
*/

import BaseLayout from "../layouts/BaseLayout.astro";

const calendarUrl =
    "https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=America%2FLos_Angeles&showCalendars=0&showPrint=0&title&showTitle=0&src=MDU1ZWJlZTc4ZmE4ZjdhODZlOGM3NjM1NzI2MWY0YjY3NWZhZTFhZjhmZDQ5YmZmZTVlNGUwYmYyYTE0ODU4MUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23e67c73";
---

<BaseLayout title="Events" description="Events :3">
    <!-- TODO: ADD A SCHEDULE HERE -->
    <section>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-10">
                    <h2>Calendar WIP :33</h2>
                </div>
            </div>
        </div>
    </section>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-10">
                <!-- Wrapper for Google Calendar -->
                <div class="calendar-wrapper">
                    <iframe
                        src={calendarUrl}
                        style="border-width:0"
                        width="800"
                        height="600"></iframe>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .calendar-wrapper {
        position: relative;
        width: 100%;
        height: 600px;
        background: var(--white);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: 0 4px 12px var(--shadow-subtle);
        transition: all 0.2s ease;
    }

    .calendar-wrapper:hover {
        border-color: var(--border-subtle-hover);
        box-shadow: 0 6px 16px var(--shadow-subtle-hover);
    }

    .calendar-wrapper iframe {
        width: 100%;
        height: 100%;
        border: 0;
    }

    /* Mobile responsiveness */
    @media (max-width: 768px) {
        .calendar-wrapper {
            height: 480px;
        }
    }
</style>
