---
/*
    Custom 404 page
*/

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="Page not found :3c">
    <div class="container py-5 not-found">
        <h1>404</h1>
        <p>page not found :3c</p>
        <img src="/img/nelli.jpg" alt="Nelli" class="nelli-img" />
    </div>
</BaseLayout>

<style>
    .not-found h1 {
        font-size: 6rem;
        font-weight: 900;
        color: var(--blue);
        line-height: 1;
    }

    .not-found p {
        font-size: 1.5rem;
        color: var(--text-muted);
    }

    .nelli-img {
        max-width: 320px;
        width: 100%;
        border-radius: var(--radius-lg);
        box-shadow: 0 8px 30px var(--blue-glow);
        margin-top: 0.5rem;
    }
</style>
