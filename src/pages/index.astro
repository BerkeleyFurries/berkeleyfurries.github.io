---
/*
    This is the home page :3
*/

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home" description="Home Page :3">
	<!-- Big banner :3 -->

	<!-- "hero" is custom -->
	<div class="hero">
		<img
			src="/img/background/Semesterly_art_1k.webp"
			alt="Berkeley Furries Hero Background"
			class="hero-bg"
			loading="eager"
			decoding="async"
		/>
		<div class="hero-overlay"></div>
		<!-- "hero-content" is custom -->
		<div
			class="d-flex flex-column align-items-center justify-content-center text-center hero-content"
		>
			<!-- "hero-text-box" is custom -->
			<div class="hero-text-box">
				<!-- "logo-wrapper" is custom -->
				<div class="logo-wrapper">
					<!-- "hero-logo" is custom -->
					<img
						src="/img/AAAA_Logo_256.webp"
						alt="Berkeley Furries Logo"
						class="hero-logo"
					/>
				</div>
				<!-- "hero-title" is custom -->
				<h1 class="hero-title">Furries @ Berkeley</h1>
				<!-- "subtitle" is custom -->
				<p class="subtitle">Meow meow meow meow! :3</p>

				<!-- "stats-badge" is custom -->
				<div
					class="d-flex align-items-center gap-2 rounded-pill stats-badge"
				>
					<span>467+ Members</span>
					<span class="dot">•</span>
					<span>Est. 2022</span>
				</div>
			</div>
		</div>
	</div>

	<!-- First block -->
	<!-- "content-section" is custom -->
	<section id="learn-more" class="content-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-10 col-xl-10">
					<h2>Furries? at <em>MY</em> university!?</h2>
					<!-- "tagline" is custom -->
					<p class="tagline">It's more likely than you think!</p>
					<!-- "card-body" is custom -->
					<div class="card-body">
						<p>
							<strong>Furries at Berkeley</strong> is a furry club at
							Berkeley under AAAA :3
						</p>
						<p>Meow :3</p>
						<p>Woof :33</p>
						<p>Chirp ^^</p>
						<p>Glub glub</p>
						<p>e e e e e e</p>
						<p>Cawww</p>
                        <p>Awooooooo 🐺</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="whats-a-furry" class="content-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-10 col-xl-10">
					<h2>What is a furry?</h2>
					<p class="tagline">They're cool :3</p>
					<div class="card-body">
						<p>Meow!</p>
						<p>Woof!</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="get-involved" class="content-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-10 col-xl-10">
					<h2>How do I get involved?</h2>
					<p class="tagline">Say hi at tabling :3</p>
					<div class="card-body">
						<p>Join discord! Or mailing list! Or both :3</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="faqs" class="content-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-10 col-xl-10">
					<h2>Common Myths & FAQs</h2>
					<p class="tagline">
						Here are some common questions we get from non-furries:
					</p>

					<div class="accordion" id="faqAccordion">
						<!-- "faq-item" is custom -->
						<!-- "accordion-button" is custom -->
						<!-- "faq-content" is custom -->
						<div class="accordion-item faq-item">
							<h2 class="accordion-header" id="headingOne">
								<button
									class="accordion-button collapsed"
									type="button"
									data-bs-toggle="collapse"
									data-bs-target="#collapseOne"
									aria-expanded="false"
									aria-controls="collapseOne"
								>
									How much is a fursuit? Do I need one?
								</button>
							</h2>
							<div
								id="collapseOne"
								class="accordion-collapse collapse"
								aria-labelledby="headingOne"
								data-bs-parent="#faqAccordion"
							>
								<div class="accordion-body faq-content">
									<p>Expensiv...</p>
									<p>No :3</p>
								</div>
							</div>
						</div>

						<div class="accordion-item faq-item">
							<h2 class="accordion-header" id="headingTwo">
								<button
									class="accordion-button collapsed"
									type="button"
									data-bs-toggle="collapse"
									data-bs-target="#collapseTwo"
									aria-expanded="false"
									aria-controls="collapseTwo"
								>
									Why are furries the way they are?
								</button>
							</h2>
							<div
								id="collapseTwo"
								class="accordion-collapse collapse"
								aria-labelledby="headingTwo"
								data-bs-parent="#faqAccordion"
							>
								<div class="accordion-body faq-content">
									<p>:3</p>
								</div>
							</div>
						</div>

						<div class="accordion-item faq-item">
							<h2 class="accordion-header" id="headingThree">
								<button
									class="accordion-button collapsed"
									type="button"
									data-bs-toggle="collapse"
									data-bs-target="#collapseThree"
									aria-expanded="false"
									aria-controls="collapseThree"
								>
									Do I have to be a furry to join?
								</button>
							</h2>
							<div
								id="collapseThree"
								class="accordion-collapse collapse"
								aria-labelledby="headingThree"
								data-bs-parent="#faqAccordion"
							>
								<div class="accordion-body faq-content">
									<p>No :D</p>
								</div>
							</div>
						</div>

						<div class="accordion-item faq-item">
							<h2 class="accordion-header" id="headingFour">
								<button
									class="accordion-button collapsed"
									type="button"
									data-bs-toggle="collapse"
									data-bs-target="#collapseFour"
									aria-expanded="false"
									aria-controls="collapseFour"
								>
									Do I have to be a student at UC Berkeley to
									join?
								</button>
							</h2>
							<div
								id="collapseFour"
								class="accordion-collapse collapse"
								aria-labelledby="headingFour"
								data-bs-parent="#faqAccordion"
							>
								<div class="accordion-body faq-content">
									<p>Nope :D</p>
								</div>
							</div>
						</div>

						<div class="accordion-item faq-item">
							<h2 class="accordion-header" id="headingFive">
								<button
									class="accordion-button collapsed"
									type="button"
									data-bs-toggle="collapse"
									data-bs-target="#collapseFive"
									aria-expanded="false"
									aria-controls="collapseFive"
								>
									Is this club exclusive to UC Berkeley?
								</button>
							</h2>
							<div
								id="collapseFive"
								class="accordion-collapse collapse"
								aria-labelledby="headingFive"
								data-bs-parent="#faqAccordion"
							>
								<div class="accordion-body faq-content">
									<p>No :3</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	:root {
	}
	.hero {
		height: 100vh;
		margin-top: 0;
		width: 100%;
		border-radius: 0;
		background-color: var(--blue); /* Instant dark blue fallback */
		border: none;
		position: relative;
		overflow: hidden;
		isolation: isolate; /* Create local stacking context for children */
	}
	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		z-index: 1;
		pointer-events: none;
	}
	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			to bottom,
			rgba(0, 18, 55, 0.45) 0%,
			rgba(0, 18, 55, 0.45) 90%,
			#ffffff 100%
		);
		z-index: 2;
		pointer-events: none;
	}
	.hero-content {
		position: sticky;
		top: 0;
		height: 100vh;
		max-height: 100%;
		width: 100%;
		padding-top: 80px;
		padding-left: 2rem;
		padding-right: 2rem;
		padding-bottom: 2rem;
		box-sizing: border-box;
		z-index: 3;
	}
	.logo-wrapper {
		position: relative;
		margin-bottom: 1rem;
		isolation: isolate;
	}
	.logo-wrapper::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 200px;
		height: 200px;
		background: radial-gradient(
			circle,
			rgba(253, 181, 21, 0.45) 0%,
			rgba(253, 181, 21, 0) 70%
		);
		border-radius: 50%;
		z-index: -1;
	}
	.hero-logo {
		width: 130px;
		height: 130px;
		filter: drop-shadow(0 4px 15px rgba(0, 0, 0, 0.15));
	}
	.hero-text-box {
		background: rgba(0, 18, 56, 0.85);
		border: 1px solid var(--white-transparent-10);
		padding: 2rem 2.5rem;
		border-radius: var(--radius-lg);
		max-width: 750px;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
		margin-top: 0.5rem;
	}
	.hero-text-box .stats-badge {
		margin-bottom: 0;
	}
	.hero-title {
		font-size: 4rem;
		font-weight: 800;
		margin-bottom: 0.5rem;
		color: var(--text-title);
		text-shadow: 0 2px 12px rgba(0, 38, 118, 0.4);
	}
	.subtitle {
		font-size: 1.5rem;
		color: var(--text-subtitle);
		font-weight: 500;
		margin-bottom: 1.25rem;
		text-shadow: 0 1px 8px rgba(0, 38, 118, 0.3);
	}

	/* Stats Badge */
	.stats-badge {
		background: color-mix(
			in srgb,
			var(--gold) 15%,
			transparent
		); /* Gold background tint */
		border: 1px solid var(--gold);
		padding: 0.4rem 1.1rem;
		font-weight: 600;
		font-size: 0.85rem;
		color: var(--gold);
		margin-bottom: 2rem;
	}
	.stats-badge .dot {
		opacity: 0.6;
	}

	/* LANDING CONTENT SECTIONS */
	.content-section {
		padding: 2rem 0;
		scroll-margin-top: 80px;
		width: 100%;
	}
	.content-section:nth-of-type(odd) {
		background-color: var(--white);
	}
	.content-section:nth-of-type(even) {
		background-color: var(--light-gray);
		border-top: 1px solid var(--border-subtle);
		border-bottom: 1px solid var(--border-subtle);
	}
	.content-section h2 {
		font-size: 2.25rem;
		font-weight: 800;
		margin-bottom: 0.5rem;
		color: var(--text-main);
		letter-spacing: -0.5px;
	}
	.content-section h2 em {
		font-style: italic;
		font-weight: 800;
		color: var(--accent);
	}
	.tagline {
		font-size: 1.15rem;
		color: var(--text-muted);
		margin-bottom: 1.75rem;
		font-weight: 400;
	}

	.card-body p {
		font-size: 1.05rem;
		color: var(--text-muted);
		line-height: 1.7;
	}
	.card-body strong {
		color: var(--text-main);
		font-weight: 600;
	}

	/* ACCORDION/FAQ STYLING */
	.faq-item {
		background: var(--white);
		border: 1px solid var(--card-border) !important;
		border-radius: var(--radius-md) !important;
		margin-bottom: 1rem;
		overflow: hidden;
		box-shadow: 0 4px 12px var(--shadow-subtle);
		transition: all 0.2s ease;
	}
	.faq-item:hover {
		border-color: var(--border-subtle-hover) !important;
		box-shadow: 0 6px 16px var(--shadow-subtle-hover);
	}
	.accordion-button {
		background-color: transparent;
		color: var(--text-main);
		font-weight: 600;
		box-shadow: none;
		padding: 1.25rem 1.5rem;
	}
	.accordion-button:not(.collapsed) {
		background-color: var(--shadow-subtle);
		color: var(--accent);
		box-shadow: none;
	}
	.accordion-button:focus {
		box-shadow: none;
	}
	.faq-content {
		padding: 0 1.5rem 1.25rem 1.5rem; /* Keep contents aligned with headers */
		border-top: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.faq-content p {
		font-size: 1rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin-bottom: 0;
	}
	@media (min-width: 769px) {
		.hero {
			height: auto;
			aspect-ratio: 3984 / 3040;
			min-height: 80vh;
		}
	}
	/* MOBILE RESPONSIVENESS */
	@media (max-width: 768px) {
		h1 {
			font-size: 2.75rem;
		}
		.hero-content {
			padding: 3rem 1rem;
		}
		.hero-text-box {
			padding: 1.5rem 1.25rem;
		}
		.stats-badge {
			font-size: 0.8rem;
			padding: 0.4rem 1rem;
			gap: 0.5rem;
		}
		.content-section {
			padding: 3rem 0;
		}
		.content-section h2 {
			font-size: 1.75rem;
		}
	}
</style>
