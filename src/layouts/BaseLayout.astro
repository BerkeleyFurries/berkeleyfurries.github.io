---
/*
    This is the base page template :3
    All pages share this layout (header taskbar, footer, global styles)
*/
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Meow meow meow!", // CHAGE THE DEFAULT DESCRIPTION HERE
} = Astro.props;

// This fetches the logo URL for rich embeds
const siteUrl = Astro.site
    ? Astro.site.href
    : "https://berkeleyfurries.github.io/";
const imageUrl = new URL("/img/AAAA_Logo_512.png", siteUrl).href;
---

<!doctype html>
<!-- Remove the style for the background loading to make it white -->
<html lang="en" style={title === "Home" ? "background-color: #001c57;" : ""}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Furries at Berkeley</title>
        <link rel="icon" type="image/png" href="/img/AAAA_Logo_256.png" />

        <!-- RICH EMBEDS -->
        <meta name="description" content={description} />
        <!-- Color is the gold from below, have to change manually -->
        <meta name="theme-color" content="#fdb515" />

        <!-- Open Graph / Facebook / Discord / Telegram -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:title" content={`${title} | Furries at Berkeley`} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:type" content="image/png" />

        <!-- Twitter Card (Discord/Telegram also read these) -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={`${title} | Furries at Berkeley`} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />

        <!-- Preloads fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Bootstrap <3 -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous"
        />

        {
            title === "Home" && (
                <link
                    rel="preload"
                    href="/img/background/Semesterly_art_1k.webp"
                    as="image"
                    type="image/webp"
                />
            )
        }

        <ClientRouter />
    </head>

    <body>
        <!-- Header -->
        <!-- "taskbar" is the custom css element -->
        <nav
            class="navbar navbar-expand-md navbar-dark fixed-top taskbar"
            transition:persist
            transition:animate="none"
        >
            <div class="container-fluid">
                <!-- "brand" is custom -->
                <a
                    href="/"
                    class="navbar-brand d-flex align-items-center brand"
                >
                    <!-- "logo" is custom -->
                    <img
                        src="/img/AAAA_Logo_256.png"
                        alt="Logo"
                        class="me-2 logo"
                    />
                    <!-- "brand-text" is custom -->
                    <span class="brand-text">Furries at Berkeley</span>
                </a>

                <!-- Mobile nav button that automatically shows when size is mobile dimensions -->
                <button
                    class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMain"
                    aria-controls="navbarMain"
                    aria-expanded="false"
                    aria-label="Toggle navigation"
                >
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Collapsing menu -->
                <!-- "navbar-collapse" is custom -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <!-- "nav-links" is custom -->
                    <ul class="navbar-nav me-auto mb-0 nav-links">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/events">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/gallery">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/artists">Artists</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/contact">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="page-content">
            <slot />
        </main>

        <!-- Pawer -->
        <footer>
            <!-- TODO: Add more to the pawer :3c -->
            <p>
                &copy; {new Date().getFullYear()} Furries at Berkeley. All rights
                reserved.
            </p>
            <p>Made with ❤️🐾</p>
        </footer>

        <!-- Bootstrap -->
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    </body>
</html>

<style is:global>
    :root {
        /* Colors */
        /* Yo is this legal to use Berkeley colors */
        --blue: #002676;
        --gold: #fdb515;
        --white: #ffffff;
        --light-gray: #f8f9fa;
        --dark-blue: #001c57;

        /* Glows & Transparency */
        --blue-glow: rgba(0, 38, 118, 0.15);
        --brand-glow-opaque: rgba(0, 38, 118, 0.25);
        --white-transparent-10: rgba(255, 255, 255, 0.1);
        --white-transparent-05: rgba(255, 255, 255, 0.05);

        --accent: var(--blue);
        --card-border: rgba(0, 38, 118, 0.12);

        /* Background of the entire page */
        --bg: var(--white);

        /* Text */
        --text-title: #f0f0f0;
        --text-subtitle: #d6d6d6;
        --text-main: #001238;
        --text-muted: #4f5f80;
        --text-taskbar: #e1e7f5;
        --text-taskbar-hover: #ffffff;
        --font-sans:
            "Comic Sans MS", sans-serif; /* TODO: CHANGE THE FONT HERE */

        /* UI Theme Metrics & Variables */
        --border-subtle: rgba(0, 38, 118, 0.04);
        --border-subtle-hover: rgba(0, 38, 118, 0.2);
        --shadow-subtle: rgba(0, 38, 118, 0.02);
        --shadow-subtle-hover: rgba(0, 38, 118, 0.05);

        /* Rounded Corners */
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 20px;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--font-sans);
        background-color: var(--bg);

        color: var(--text-main);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
    }

    /* Navigation Bar */
    .taskbar {
        background: var(--blue);
        border-bottom: 2px solid var(--gold);
        box-shadow: 0 4px 20px var(--blue-glow);
        z-index: 100;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
    }

    .brand-text {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: var(--text-title);
    }

    .logo {
        width: 42px;
        height: 42px;
        filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.3));
        transition: transform 0.3s ease;
    }

    .brand:hover .logo {
        transform: rotate(8deg) scale(1.05);
    }

    .nav-links {
        display: flex;
        gap: 1.5rem;
    }

    .nav-links a {
        color: var(--text-taskbar);
        transition: all 0.3s ease;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
    }

    .nav-links a:hover {
        color: var(--text-taskbar-hover);
        background: rgba(255, 255, 255, 0.12);
    }

    @media (max-width: 767.98px) {
        .navbar-collapse {
            background: var(--dark-blue);
            margin-top: 0.75rem;
            padding: 0.5rem 1rem;
            border-radius: var(--radius-sm);
            box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.2);
        }
        .nav-links {
            flex-direction: column;
            gap: 0;
        }
        .nav-links li {
            border-bottom: 1px solid var(--white-transparent-10);
            width: 100%;
        }
        .nav-links li:last-child {
            border-bottom: none;
        }
        .nav-links a {
            display: block;
            padding: 0.75rem 0.5rem;
            border-radius: 0;
        }
        .nav-links a:hover {
            background: var(--white-transparent-05);
        }
    }

    .page-content {
        margin-top: 80px; /* offset the fixed header */
        flex: 1;
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    /* Standard container utility for other pages and page content */
    .container {
        max-width: 1200px;
        width: 100%;
        margin-left: auto;
        margin-right: auto;
        padding: 2.5rem 2rem;
    }

    /* Footer */
    footer {
        text-align: center;
        padding: 2.5rem;
        background: var(--blue);
        border-top: 2px solid var(--gold);
        color: var(--text-taskbar);
        font-size: 0.95rem;
    }

    footer p {
        margin-bottom: 0.5rem;
    }
</style>
